{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dynamics-atlas.invalid/schemas/rules-v1/source-evidence-packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_packet_id", "paper_id", "source_locator", "short_passage", "atomic_paper_statement", "proposed_reusable_use", "forbidden_generalization", "human_review_status", "derivative_kind"],
  "properties": {
    "evidence_packet_id": {"type": "string", "pattern": "^SEP-F[0-9]{2}-"},
    "paper_id": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "short_passage": {"type": "string", "minLength": 1},
    "atomic_paper_statement": {"type": "string", "minLength": 1},
    "proposed_reusable_use": {"type": "string", "minLength": 1},
    "forbidden_generalization": {"type": "string", "minLength": 1},
    "human_review_status": {"enum": ["PENDING", "VERIFIED_FOR_PROPOSED_CONTROL_LOGIC"]},
    "review_disposition_scope": {"type": "string", "minLength": 1},
    "derivative_kind": {"const": "UPSTREAM_REVIEW_DERIVATIVE_NOT_PRIMARY_VERBATIM"}
  }
}

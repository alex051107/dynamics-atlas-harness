{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dynamics-atlas.invalid/schemas/rules-v1/resolution-policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolution_policy_id", "purpose", "allowed_routes", "operator_route_allowed", "operator_route_conditions", "unresolved_route", "fail_route", "completion_evidence", "forbidden_actions"],
  "properties": {
    "resolution_policy_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "allowed_routes": {"type": "array", "minItems": 1, "items": {"enum": ["DIRECT_EVALUATION", "SOURCE_LOOKUP", "REGISTERED_OPERATOR", "HUMAN_OR_NEW_DATA"]}},
    "operator_route_allowed": {"type": "boolean"},
    "operator_route_conditions": {"type": "array", "items": {"type": "string"}},
    "unresolved_route": {"enum": ["DIRECT_EVALUATION", "SOURCE_LOOKUP", "REGISTERED_OPERATOR", "HUMAN_OR_NEW_DATA"]},
    "fail_route": {"enum": ["DIRECT_EVALUATION", "SOURCE_LOOKUP", "REGISTERED_OPERATOR", "HUMAN_OR_NEW_DATA"]},
    "completion_evidence": {"type": "array", "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dynamics-atlas.invalid/schemas/rules-v1/runtime-subrule",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime_subrule_id", "family_id", "target_kind", "scientific_question", "required_evidence_packet_ids", "failure_mode", "claim_effect_summary", "implementation_status"],
  "properties": {
    "runtime_subrule_id": {"type": "string", "pattern": "^F[0-9]{2}R[0-9]{2}_"},
    "family_id": {"type": "string", "pattern": "^F[0-9]{2}_"},
    "target_kind": {"enum": ["CASE", "SOURCE", "EDGE"]},
    "scientific_question": {"type": "string", "minLength": 1},
    "required_evidence_packet_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_mode": {"type": "string", "minLength": 1},
    "claim_effect_summary": {"type": "string", "minLength": 1},
    "implementation_status": {"enum": ["COMPLETE_DRAFT", "CANDIDATE_MAP_ONLY"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dynamics-atlas.invalid/schemas/rules-v1/applicability-binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_id", "runtime_subrule_id", "target_kind", "applicability", "required_evidence_paths", "resolution_policy_id", "evaluation_contract_id", "implementation_status"],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "runtime_subrule_id": {"type": "string", "minLength": 1},
    "target_kind": {"enum": ["CASE", "SOURCE", "EDGE"]},
    "iteration": {"type": "object", "required": ["op"], "properties": {"op": {"enum": ["FOR_EACH_SOURCE", "FOR_EACH_EDGE"]}}},
    "applicability": {"$ref": "#/$defs/predicate"},
    "required_evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(case|source|edge)\\."}},
    "resolution_policy_id": {"type": "string", "minLength": 1},
    "evaluation_contract_id": {"type": "string", "minLength": 1},
    "implementation_status": {"enum": ["COMPLETE_DRAFT", "CANDIDATE_MAP_ONLY"]}
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"enum": ["EQ", "IN", "EXISTS", "ALL", "ANY", "NOT"]},
        "path": {"type": "string"},
        "value": {},
        "values": {"type": "array"},
        "values_path": {"type": "string"},
        "arg": {"$ref": "#/$defs/predicate"},
        "args": {"type": "array", "items": {"$ref": "#/$defs/predicate"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal exposed Stage-2 conclusion packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_kind",
    "development_status",
    "scenario_id",
    "case_id",
    "requested_claim",
    "current_claim_ceiling",
    "terminal_disposition",
    "route_disposition",
    "required_rule_results",
    "failed_rule_results",
    "unresolved_rule_results",
    "advisory_rule_results",
    "evidence_results",
    "operator_receipts",
    "source_science_review_status",
    "source_science_review_records",
    "first_failed_dependency",
    "human_final_authority",
    "unsafe_claim_upgrade",
    "human_review_items",
    "next_action",
    "route_artifact",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "stage2-conclusion-packet/v1-alpha"},
    "packet_kind": {"const": "MINIMAL_STAGE2_EXPOSED_CONCLUSION_V1"},
    "development_status": {"const": "EXPOSED_DEVELOPMENT_ACTIVE"},
    "scenario_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "requested_claim": {"type": "string", "minLength": 1},
    "current_claim_ceiling": {"type": "string", "minLength": 1},
    "terminal_disposition": {
      "enum": [
        "SUPPORT_WITHIN_CEILING",
        "CANNOT_SUPPORT_REQUESTED_CLAIM",
        "ABSTAIN_OR_HUMAN_REVIEW"
      ]
    },
    "route_disposition": {"type": "string", "minLength": 1},
    "required_rule_results": {"type": "array", "minItems": 1},
    "failed_rule_results": {"type": "array"},
    "unresolved_rule_results": {"type": "array"},
    "advisory_rule_results": {"type": "array"},
    "evidence_results": {"type": "array"},
    "operator_receipts": {"type": "array"},
    "source_science_review_status": {
      "enum": ["VERIFIED", "PENDING_DOMAIN_REVIEW", "REJECTED", "MIXED"]
    },
    "source_science_review_records": {"type": "array", "minItems": 1},
    "first_failed_dependency": {"type": ["object", "null"]},
    "human_final_authority": {"const": true},
    "unsafe_claim_upgrade": {"const": false},
    "human_review_items": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_action": {"type": "string", "minLength": 1},
    "route_artifact": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
